{
    "name": "boldlygrow/okta-api-client",
    "description": "Okta API Client for Laravel",
    "homepage": "https://github.com/boldlygrow/okta-api-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeff Martin",
            "email": "jeff@boldlygrow.us"
        }
    ],
    "replace": {
        "provisionesta/okta-api-client": "self.version",
        "gitlab-it/okta-sdk": "self.version",
        "glamstack/okta-sdk": "self.version"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "boldlygrow/audit-log": "dev-main"
        "illuminate/config": "^11.0 || ^12.0 || ^13.0",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/log": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    },
    "require-dev": {
        "larastan/larastan": "^2.7 || ^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "BoldlyGrow\\Okta\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BoldlyGrow\\Okta\\OktaApiServiceProvider"
            ]
        }
    }
}
